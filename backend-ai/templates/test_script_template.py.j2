    def log(self, message: str, level: str = "INFO") -> None:
        colors: Dict[str, Any] = {"ERROR": Fore.RED, "SUCCESS": Fore.GREEN, "INFO": Fore.CYAN}
        symbols: Dict[str, str] = {"ERROR": "✗", "SUCCESS": "✓", "INFO": "i"}
        color = colors.get(level, Fore.YELLOW)
        symbol = symbols.get(level, "*")
        print(f"{color}[{symbol}]{Style.RESET_ALL} [{datetime.now().strftime('%H:%M:%S')}] {message}")
    
    def vlog(self, message: str) -> None:
        if self.verbose:
            print(f"    {Fore.CYAN}→{Style.RESET_ALL} {message}")
    
    def login(self, username: Optional[str] = None, password: Optional[str] = None) -> bool:
        """登录获取JWT Token"""
        login_user = username or self.username
        login_pass = password or self.password
        url = f"{self.base_url}/api/auth/login"
        try:
            resp = requests.post(url, json={
                "username": login_user,
                "password": login_pass
            }, timeout=10)
            self.vlog(f"POST /api/auth/login -> {resp.status_code}")
            if resp.status_code == 200:
                data = resp.json()
                self.token = data.get("data", {}).get("token")
                if not self.token:
                    self.token = data.get("token")
                if self.token:
                    self.log(f"登录成功: {login_user}", "SUCCESS")
                    return True
                else:
                    self.log(f"登录响应中未找到token, 响应: {data}", "ERROR")
                    return False
            else:
                self.log(f"登录失败: HTTP {resp.status_code}", "ERROR")
                return False
        except Exception as e:
            self.log(f"登录异常: {e}", "ERROR")
            return False
    
    def switch_role(self, role: str) -> None:
        """切换当前模拟角色"""
        account = self.accounts.get(role, {"user": f"test_{role}", "groups": role})
        self.current_test_user = account["user"]
        self.current_test_groups = account["groups"]
        self.vlog(f"切换角色: {role} -> user={self.current_test_user}, groups={self.current_test_groups}")
    
    def _get_headers(self) -> Dict[str, str]:
        """获取请求头"""
        headers: Dict[str, str] = {"Content-Type": "application/json"}
        if self.test_mode:
            headers["X-Test-User"] = self.current_test_user
            headers["X-Test-Groups"] = self.current_test_groups
        elif self.token:
            headers["Authorization"] = f"Bearer {self.token}"
        return headers
    
    def request(self, method: str, url: str, data: Optional[Dict[str, Any]] = None, params: Optional[Dict[str, Any]] = None) -> Tuple[bool, Dict[str, Any]]:
        """发送HTTP请求（使用完整URL）"""
        headers = self._get_headers()
        try:
            resp: Any
            if method == "GET":
                resp = requests.get(url, params=params, headers=headers, timeout=10)
            else:
                resp = requests.post(url, json=data, params=params, headers=headers, timeout=10)
            self.vlog(f"{method} {url} -> {resp.status_code}")
            if resp.status_code == 403:
                self.vlog(f"⚠️ 403 Forbidden - user={self.current_test_user}, groups={self.current_test_groups}")
            if resp.status_code == 200:
                return True, resp.json()
            else:
                error_body = {}
                try:
                    error_body = resp.json()
                except Exception:
                    error_body = {"error": resp.status_code, "text": resp.text[:200]}
                return False, error_body
        except Exception as e:
            return False, {"error": str(e)}
    
    def submit_request(self, **kwargs: Any) -> Optional[str]:
        """
        提交流程申请
        调用: POST /api/{flowType}/apply
        Body: 表单字段直接作为JSON body
        """
        data: Dict[str, Any] = {}
        for key, value in kwargs.items():
            english_key = self.field_mapping.get(key, key)
            converted_value = self._convert_field_value(english_key, value)
            data[english_key] = converted_value
        
        url = f"{self.base_url}{self.api_prefix}/apply"
        self.vlog(f"提交数据: {json.dumps(data, ensure_ascii=False)}")
        ok, resp = self.request("POST", url, data)
        if ok and resp.get("success"):
            process_id = resp.get("processInstanceId")
            self.vlog(f"提交成功: processInstanceId={process_id}")
            return process_id  # type: ignore
        else:
            error_msg = resp.get("message", resp.get("error", str(resp)))
            self.log(f"    ⚠ 后端返回: {error_msg}", "ERROR")
            self.vlog(f"提交失败详情: {resp}")
        return None
    
    def _load_config(self) -> Dict[str, Any]:
        """加载配置（内嵌字段定义）"""
        return {
            "formFields": [
                {% if form_fields %}{% for field in form_fields %}{"name": "{{ field.get('name', '') }}", "label": "{{ field.get('label', '') }}", "type": "{{ field.get('type', 'string') }}"}{{ "," if not loop.last else "" }}
                {% endfor %}{% endif %}
            ]
        }
    
    def _get_field_config(self, field_name: str) -> Optional[Dict[str, Any]]:
        """获取字段配置"""
        for field in self.config.get('formFields', []):
            if field.get('name') == field_name:
                return field
        return None
    
    def _extract_number(self, value: Any) -> float:
        """从值中提取数字"""
        if isinstance(value, (int, float)):
            return float(value)
        match = re.search(r'[\d.]+', str(value))
        if match:
            return float(match.group())
        raise ValueError(f"无法从 '{value}' 中提取数字")
    
    def _normalize_date(self, value: Any) -> str:
        """标准化日期格式"""
        if isinstance(value, str) and re.match(r'\d{4}-\d{2}-\d{2}', value):
            return value
        return str(value)
    
    def _parse_boolean(self, value: Any) -> bool:
        """解析布尔值"""
        if isinstance(value, bool):
            return value
        if isinstance(value, str):
            return value.lower() in ('true', 'yes', '是', '1', 'y')
        return bool(value)
    
    def _convert_field_value(self, field_name: str, value: Any) -> Any:
        """根据配置的字段类型智能转换值"""
        field_config = self._get_field_config(field_name)
        if not field_config:
            # 即使没有字段配置，也尝试智能推断类型
            return self._auto_convert_value(field_name, value)
        
        field_type = field_config.get('type', 'string')
        
        try:
            if field_type == 'number':
                return self._extract_number(value)
            elif field_type == 'date':
                return self._normalize_date(value)
            elif field_type == 'boolean':
                return self._parse_boolean(value)
            else:
                return str(value) if value is not None else value
        except Exception as e:
            self.vlog(f"警告: 字段 '{field_name}' 类型转换失败: {e}, 使用原值")
            return value
    
    def _auto_convert_value(self, field_name: str, value: Any) -> Any:
        """当没有字段配置时，根据字段名和值格式自动推断类型并转换"""
        if isinstance(value, (int, float, bool)):
            return value  # 已经是正确类型
        if not isinstance(value, str):
            return value
        # 尝试转为数字：如果值看起来像纯数字
        if re.match(r'^-?\d+(\.\d+)?$', value.strip()):
            try:
                num = float(value.strip())
                return int(num) if num == int(num) else num
            except (ValueError, OverflowError):
                pass
        # 根据字段名推断是否应为数字
        number_keywords = ['days', 'amount', 'count', 'hours', 'total', 'cost', 'remaining', 'num', 'quantity', 'price']
        if any(kw in field_name.lower() for kw in number_keywords):
            try:
                num = self._extract_number(value)
                return int(num) if num == int(num) else num
            except (ValueError, TypeError):
                pass
        return value
    
    def get_tasks(self) -> List[Dict[str, Any]]:
        """
        查询待办任务列表
        调用: GET /api/{flowType}/task/list
        """
        url = f"{self.base_url}{self.api_prefix}/task/list"
        ok, resp = self.request("GET", url)
        if ok:
            # 响应可能是列表或包装在data中
            if isinstance(resp, list):
                return resp
            return resp.get("data", resp.get("tasks", []))
        return []
    
    def approve(self, task_id: str, approved: bool = True, comment: str = "测试审批") -> bool:
        """
        审批任务
        调用: POST /api/{flowType}/approve/{taskId}?approved=true&comment=xxx
        """
        url = f"{self.base_url}{self.api_prefix}/approve/{task_id}"
        params = {"approved": str(approved).lower(), "comment": comment}
        ok, resp = self.request("POST", url, params=params)
        return ok and resp.get("success", False)  # type: ignore
    
    def find_task(self, process_instance_id: str) -> Optional[str]:
        """
        从待办任务列表中查找指定流程实例的任务
        """
        tasks = self.get_tasks()
        for task in tasks:
            # 尝试多种方式匹配
            task_process_id = task.get("processInstanceId", task.get("processId", ""))
            if task_process_id == process_instance_id:
                return task.get("taskId", task.get("id"))  # type: ignore
        # 如果找不到精确匹配，返回最新的任务
        if tasks:
            self.vlog(f"未精确匹配到 processInstanceId={process_instance_id}，共有 {len(tasks)} 个待办任务")
            # 尝试返回第一个任务（可能就是我们刚创建的）
            return tasks[0].get("taskId", tasks[0].get("id"))
        return None
    
    def _drain_remaining_tasks(self, process_instance_id: str, max_iterations: int = 5) -> int:
        """自动完成剩余的后续任务（如申请人确认、通知类任务等）"""
        completed = 0
        for _ in range(max_iterations):
            task_id = self.find_task(process_instance_id)
            if task_id:
                if self.approve(task_id, True, "确认知悉"):
                    completed += 1
                    self.vlog(f"完成后续任务: taskId={task_id}")
                    time.sleep(0.5)
                else:
                    break
            else:
                break
        return completed
    
    def test_health(self):
        """
        健康检查 - 验证后端服务是否可达
        尝试 /actuator/health 或直接访问根路径
        """
        # 先尝试 Spring Boot Actuator
        url = f"{self.base_url}/actuator/health"
        ok, data = self.request("GET", url)
        if ok:
            status = data.get("status", "") == "UP"
            result_str = "PASS" if status else "FAIL"
            self.log(f"健康检查 (Actuator): {result_str}", "SUCCESS" if status else "ERROR")
            self.test_results.append({"name": "健康检查", "status": result_str})
            return status
        
        # 回退：尝试任务列表接口是否可达
        url2 = f"{self.base_url}{self.api_prefix}/task/list"
        ok2, data2 = self.request("GET", url2)
        if ok2:
            self.log(f"健康检查 (API可达): PASS", "SUCCESS")
            self.test_results.append({"name": "健康检查", "status": "PASS"})
            return True
        
        self.log(f"健康检查: FAIL - 服务不可达", "ERROR")
        self.test_results.append({"name": "健康检查", "status": "FAIL"})
        return False
    
