def main():
    parser = argparse.ArgumentParser(description="{{ process_name }}自动化测试")
    parser.add_argument('--url', default='http://localhost:8080', help='服务器地址')
    parser.add_argument('--user', default='admin', help='登录用户名 (默认: admin)')
    parser.add_argument('--password', default='admin123', help='登录密码 (默认: admin123)')
    parser.add_argument('--test', help='指定测试: health, {% for tc in test_cases %}{{ tc.id }}{{ ", " if not loop.last else "" }}{% endfor %}, all')
    parser.add_argument('--verbose', '-v', action='store_true', help='详细输出')
    args = parser.parse_args()
    
    tester = {{ class_name }}(args.url, args.verbose, args.user, args.password)
    
    if args.test:
        if not tester.test_mode:
            if not tester.login():
                tester.log("登录失败，无法执行测试", "ERROR")
                sys.exit(1)
        
        test_map = {
            'health': tester.test_health,
            {% for test_case in test_cases %}'{{ test_case.id }}': tester.test_{{ test_case.id }},
            {% endfor %}'all': tester.run_all_tests
        }
        test_func = test_map.get(args.test.lower())
        if test_func:
            test_func()
            if args.test.lower() != 'all':
                tester.print_summary()
        else:
            print(f"{Fore.RED}未知测试: {args.test}{Style.RESET_ALL}")
            print(f"可用测试: {', '.join(test_map.keys())}")
    else:
        tester.run_all_tests()

if __name__ == "__main__":
    main()
