    def print_summary(self):
        print(f"\n{Fore.CYAN}{'='*60}{Style.RESET_ALL}")
        print(f"{Fore.CYAN}测试摘要{Style.RESET_ALL}")
        print(f"{Fore.CYAN}{'='*60}{Style.RESET_ALL}")
        passed = sum(1 for r in self.test_results if r["status"] == "PASS")
        failed = len(self.test_results) - passed
        total_time = sum(r.get("time", 0) for r in self.test_results)
        print(f"总测试数: {len(self.test_results)}")
        print(f"{Fore.GREEN}通过: {passed}{Style.RESET_ALL}")
        print(f"{Fore.RED}失败: {failed}{Style.RESET_ALL}")
        print(f"总耗时: {total_time:.2f}s")
        print(f"成功率: {(passed/len(self.test_results)*100):.1f}%" if self.test_results else "N/A")
        print(f"{Fore.CYAN}{'='*60}{Style.RESET_ALL}\n")
        if failed > 0:
            print(f"{Fore.RED}失败的测试:{Style.RESET_ALL}")
            for r in self.test_results:
                if r["status"] == "FAIL":
                    print(f"  - {r['name']}: {r.get('error', 'Unknown error')}")
    
